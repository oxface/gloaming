{
  "$schema": "https://json.schemastore.org/template",
  "author": "Modulith Foundry",
  "classifications": ["Console", "Solution"],
  "identity": "ModulithFoundry.StateStored.Rehearsal",
  "name": "Foundry state-stored adoption rehearsal",
  "shortName": "foundry-state-stored",
  "sourceName": "FoundryApplication",
  "preferNameDirectory": true,
  "tags": {"language": "C#", "type": "solution"},
  "symbols": {
    "CatalogWorker": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Include the separately hosted Catalog report worker"
    },
    "RootNamespace": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": true,
      "replaces": "ConsumerRoot",
      "description": "Consumer-owned C# root namespace"
    }
  },
  "sources": [{"modifiers": [
    {"copyOnly": ["libraries/**", "library-sources.json"]},
    {"condition": "(!CatalogWorker)", "exclude": ["src/FoundryApplication.CatalogWorker/**", "tests/FoundryApplication.Adoption.Tests/WorkerJourneyTests.cs"]}
  ]}]
}
