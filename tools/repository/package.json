{
  "name": "gloaming-repository-tools",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "references": "node check-references.ts",
    "test": "node --test references.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write '*.ts' '*.json' '*.md'",
    "format:check": "prettier --check '*.ts' '*.json' '*.md'",
    "check": "npm run typecheck && npm run format:check && npm test && npm run references"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "lefthook": "2.2.2"
  }
}
