{
  "name": "gloaming-repository-tools",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "references": "node check-references.ts",
    "test": "node --test *.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write '*.ts' '*.json' '*.md'",
    "format:check": "prettier --check '*.ts' '*.json' '*.md'",
    "check": "npm run typecheck && npm run format:check && npm test && npm run references"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.6.5",
    "@types/picomatch": "2.3.4",
    "js-yaml": "5.5.0",
    "lefthook": "2.2.2",
    "picomatch": "2.3.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
