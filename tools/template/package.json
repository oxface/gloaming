{
  "name": "modulith-foundry-template-tools",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "create": "node create.ts",
    "verify": "node verify.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write '*.ts' '*.json'",
    "format:check": "prettier --check '*.ts' '*.json'",
    "check": "npm run typecheck && npm run format:check"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "koffi": "3.3.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "fast-xml-parser": "5.11.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
