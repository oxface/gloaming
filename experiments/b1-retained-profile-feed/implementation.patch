+
+        Assert.Equal(
+            audits,
+            await FeedProof.ScalarAsync(source, "SELECT count(*) FROM sales.audit_entries", Token)
+        );
+        Assert.Equal(
+            outgoing,
+            await FeedProof.ScalarAsync(source, "SELECT count(*) FROM sales.outbox_messages", Token)
+        );
+    }
+}
